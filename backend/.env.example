# PostgreSQL — local dev (Postgres.app on your Mac)
DATABASE_URL=postgresql+psycopg://postgres:2007@localhost:5432/crime_network

# Neo4j — start with: docker compose up -d neo4j  (from backend-api/)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=vigilneo4j2026
NEO4J_ENABLED=true

# Auth — change JWT_SECRET in production; passwords verified via salted hashes
JWT_SECRET=change-me-in-production-use-long-random-secret
AUTH_ENABLED=true
AUTH_PASSWORD_SALT=vigil-demo-salt-change-in-production

# Demo accounts (documented in docs/SETUP.md):
